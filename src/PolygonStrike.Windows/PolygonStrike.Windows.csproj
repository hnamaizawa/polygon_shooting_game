<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>PolygonStrike</AssemblyName>
    <RootNamespace>PolygonStrike.Windows</RootNamespace>
    <Version>0.6.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\index.html" LogicalName="web.index.html" />
    <EmbeddedResource Include="..\..\style.css" LogicalName="web.style.css" />
    <EmbeddedResource Include="..\game-core.js" LogicalName="web.src.game-core.js" />
    <EmbeddedResource Include="..\v052-enhancements.js" LogicalName="web.src.v052-enhancements.js" />
    <EmbeddedResource Include="..\release-version.js" LogicalName="web.src.release-version.js" />
    <EmbeddedResource Include="..\audio.js" LogicalName="web.src.audio.js" />
    <EmbeddedResource Include="..\game.js" LogicalName="web.src.game.js" />
  </ItemGroup>
</Project>
